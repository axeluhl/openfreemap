[Unit]
Description=Ingest OpenFreeMap tile-auth secret from EC2 user data into the nginx config
Documentation=https://github.com/hyperknot/openfreemap/blob/main/docs/self_hosting.md
# The instance metadata service (IMDS) is link-local, so no internet is needed, but wait for
# the network to be configured. local-fs.target guarantees the btrfs tiles under /mnt/ofm are
# mounted (they come from /etc/fstab), which write_nginx_config() needs to build the location
# blocks.
Wants=network-online.target
After=network-online.target local-fs.target
# Ordering-only dependency: nginx starts *after* this unit at boot (both are pulled in by
# multi-user.target), so a TILE_AUTH_SECRETS provided via user data is applied before nginx
# serves. Deliberately NOT a hard Requires= on nginx's side -- a deploy-time or manual
# `systemctl restart nginx` must never be blocked by this unit.
Before=nginx.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Never leaves a secret on the command line; the value is read from IMDS inside the process.
ExecStart=/data/ofm/venv/bin/python -u /data/ofm/http_host/bin/http_host.py apply-user-data-secrets

[Install]
WantedBy=multi-user.target
