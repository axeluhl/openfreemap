# Leave this empty if you use SSH keys
SSH_PASSWD=

# domain/subdomain
# Set up an A record pointing to your server's IP address and
# write the full domain here.
# TLS is terminated upstream (e.g. an AWS ALB); nginx only serves plain
# HTTP on port 80, so no certificate/email settings are needed.
DOMAIN_DIRECT=maps.example.com

# Skip the full planet download, useful for testing (true/false)
SKIP_PLANET=false



### --- Advanced setup below this line --- ###
### --- 99.9% you don't need any of this! --- ###

# DOMAIN_ROUNDROBIN is only consumed by the optional loadbalancer/tile_gen
# modules. For a single host behind an ALB, you don't need it!
DOMAIN_ROUNDROBIN=

# Variables used by the load balancer script - you don't need these!
HTTP_HOST_LIST=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

