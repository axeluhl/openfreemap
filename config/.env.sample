# Leave this empty if you use SSH keys
SSH_PASSWD=

# domain/subdomain
# Public hostname used as the nginx server_name and in the generated
# TileJSON/style URLs (e.g. maptiles.sapsailing.com). Point a DNS record
# (Route53 A/ALIAS -> ALB) at it. This is a fallback: the init-server
# http-host-* commands also accept --domain, which overrides this value.
# TLS is terminated upstream (e.g. an AWS ALB); nginx only serves plain
# HTTP on port 80, so no certificate/email settings are needed.
DOMAIN_DIRECT=maps.example.com

# Skip the full planet download, useful for testing (true/false)
SKIP_PLANET=false

# Optional: restrict tile-server access with short-lived signed tokens
# (nginx secure_link). Leave empty to keep the tile server fully public.
#
# Format: a comma-separated list of kid:secret pairs, e.g.
#   TILE_AUTH_SECRETS=k1:AbC-123_xyz,k2:Def-456_uvw
# The comma separates entries and the (first) colon separates a kid from its
# secret, so BOTH kids and secrets must match the URL-safe base64url alphabet
# [A-Za-z0-9_-] -- no commas, colons, spaces or quotes inside a secret (this is
# a hard rule, not a convention: a comma in a secret would be parsed as an entry
# boundary). There is no escaping mechanism by design. Generate secrets e.g. with:
#   openssl rand -base64 48 | tr '+/' '-_' | tr -d '='
#
# The SAME string is configured verbatim on the application side (git-sail
# system property map.provider.tileserver.auth.secrets), so both ends share one
# secret set. Rotate by appending a new kid (k3:...) and redeploying; keep old
# kids until their tokens have expired, then drop them. This value is re-applied
# on every deploy, so it is the single source of truth.
TILE_AUTH_SECRETS=

### --- Advanced setup below this line --- ###
### --- 99.9% you don't need any of this! --- ###

# DOMAIN_ROUNDROBIN is only consumed by the optional loadbalancer/tile_gen
# modules. For a single host behind an ALB, you don't need it!
DOMAIN_ROUNDROBIN=

# Variables used by the load balancer script - you don't need these!
HTTP_HOST_LIST=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

